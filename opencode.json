{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (rate limited)",
      "options": {
        "baseURL": "http://127.0.0.1:4445/v1",
        "apiKey": "unused-injected-by-proxy"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  }
}
